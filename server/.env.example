# GitUpskill Backend Environment Variables
# Copy this file to .env or set these as system environment variables

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
# MongoDB connection string
# For local development: mongodb://localhost:27017/gitupskill
# For MongoDB Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/gitupskill
MONGODB_URI=mongodb://localhost:27017/gitupskill

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate a secure 256-bit secret key (minimum 32 characters)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-chars

# Token expiration times (in milliseconds)
# Access token: 15 minutes = 900000ms
# Refresh token: 7 days = 604800000ms
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# Create a GitHub OAuth App at: https://github.com/settings/developers
# 
# Steps:
# 1. Go to GitHub Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# 2. Application name: GitUpskill (or your preferred name)
# 3. Homepage URL: http://localhost:3000 (for development)
# 4. Authorization callback URL: http://localhost:3000/auth/github/callback
# 5. Click "Register application"
# 6. Copy the Client ID and generate a Client Secret

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
#
# Steps:
# 1. Go to https://platform.openai.com
# 2. Sign in or create an account
# 3. Navigate to API Keys section
# 4. Create a new API key
# 5. Copy and paste it below

OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (gpt-4o-mini is recommended for cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens per request
OPENAI_MAX_TOKENS=2000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Maximum number of repositories to analyze per request
APP_MAX_REPOS=10

# Maximum file size to analyze (in bytes) - 500KB default
APP_MAX_FILE_SIZE=500000
