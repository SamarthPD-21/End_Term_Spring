# ===============================
# GitUpskill Application Configuration
# ===============================

spring.application.name=gitupskill

# Server Configuration
server.port=8080

# ===============================
# MongoDB Configuration
# ===============================
spring.data.mongodb.uri=mongodb://localhost:27017/gitupskilldb

# ===============================
# JWT Configuration
# ===============================
# Generate a secure key: openssl rand -base64 64
# Key must be at least 32 characters (256 bits) for HS256
jwt.secret=ThisIsASecureSecretKeyForGitUpskillAppThatIsLongEnough64Chars
jwt.expiration=86400000
jwt.refresh-expiration=604800000

# ===============================
# GitHub OAuth Configuration
# ===============================
# Get these from: https://github.com/settings/developers
github.client-id=
github.client-secret=
github.redirect-uri=
github.scope=read:user user:email repo


# ===============================
# OpenAI Configuration
# ===============================
# Get your API key from: https://platform.openai.com/api-keys
openai.api-key=YOUR_OPENAI_API_KEY_HERE
openai.model=gpt-4o-mini
openai.base-url=https://api.openai.com/v1
openai.max-tokens=2000
openai.temperature=0.3

# ===============================
# Logging Configuration
# ===============================
logging.level.com.example.endtrem=DEBUG
logging.level.org.springframework.security=INFO
logging.level.org.springframework.web=INFO
